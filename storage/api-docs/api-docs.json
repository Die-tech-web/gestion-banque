    "components": {
        "schemas": {
            "CompteResource": {
                "title": "Compte Resource",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "example": 1
                    },
                    "numeroCompte": {
                        "type": "string",
                        "example": "CM123456789"
                    },
                    "client_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "courant",
                            "epargne"
                        ],
                        "example": "courant"
                    },
                    "devise": {
                        "type": "string",
                        "example": "XAF"
                    },
                    "dateCreation": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-10-23T12:00:00.000000Z"
                    },
                    "statut": {
                        "type": "string",
                        "enum": [
                            "actif",
                            "ferme",
                            "suspendu"
                        ],
                        "example": "actif"
                    },
                    "derniereModification": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-10-23T12:00:00.000000Z"
                    },
                    "version": {
                        "type": "integer",
                        "example": 1
                    },
                    "client": {
                        "properties": {
                            "id": {
                                "type": "integer",
                                "example": 1
                            },
                            "user_id": {
                                "type": "integer",
                                "example": 1
                            },
                            "user": {
                                "properties": {
                                    "id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "name": {
                                        "type": "string",
                                        "example": "John Doe"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "john.doe@example.com"
                                    }
                                },
                                "type": "object"
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            }
