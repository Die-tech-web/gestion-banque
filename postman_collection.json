{
  "info": {
    "name": "Gestion Compte API - Tests Complets",
    "description": "Collection Postman pour tester tous les endpoints de l'API Gestion Compte",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "api_name",
      "value": "die.niang",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "2|wBLjXJ0yli42BmqguRgu8HyBgnRMQj0113UZpwDobc3c1b9b",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentification",
      "item": [
        {
          "name": "Obtenir un token d'authentification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": ["{{base_url}}"],
              "path": ["api", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Création de Compte",
      "item": [
        {
          "name": "Créer un compte avec nouveau client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"cheque\",\n  \"soldeInitial\": 500000,\n  \"devise\": \"FCFA\",\n  \"client\": {\n    \"titulaire\": \"rama gueye\",\n    \"nci\": \"1234567890123\",\n    \"email\": \"ramatoulaye.rtg@gmail.com\",\n    \"telephone\": \"+221771279062\",\n    \"adresse\": \"Dakar, Sénégal\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/{{api_name}}/comptes",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "{{api_name}}", "comptes"]
            }
          }
        },
        {
          "name": "Créer un compte avec client existant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"cheque\",\n  \"soldeInitial\": 100000,\n  \"devise\": \"FCFA\",\n  \"client\": {\n    \"id\": 1\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/{{api_name}}/comptes",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "{{api_name}}", "comptes"]
            }
          }
        }
      ]
    },
    {
      "name": "Gestion des Comptes",
      "item": [
