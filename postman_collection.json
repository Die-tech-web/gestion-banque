            },
            "url": {
              "raw": "{{base_url}}/api/v1/{{api_name}}/comptes/9/debloquer",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "{{api_name}}", "comptes", "9", "debloquer"]
